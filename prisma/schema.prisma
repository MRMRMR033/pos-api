generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StockMovement {
  id         Int            @id @default(autoincrement())
  productoId Int
  tipo       MovimientoTipo
  cantidad   Int
  motivo     String?
  usuarioId  Int
  createdAt  DateTime       @default(now())
  producto   Producto       @relation(fields: [productoId], references: [id])
  usuario    Usuario        @relation(fields: [usuarioId], references: [id])

  @@index([productoId, createdAt], map: "idx_stockmovement_producto_fecha")
}


model OrdenCompra {
  id            Int                   @id @default(autoincrement())
  numeroOrden   String                @unique
  proveedorId   Int
  usuarioId     Int
  estado        EstadoOrden           @default(PENDIENTE)
  fechaOrden    DateTime              @default(now())
  fechaEntrega  DateTime?
  subtotal      Decimal               @default(0) @db.Decimal(12, 2)
  impuestos     Decimal               @default(0) @db.Decimal(12, 2)
  total         Decimal               @default(0) @db.Decimal(12, 2)
  observaciones String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  proveedor     Proveedor             @relation(fields: [proveedorId], references: [id])
  usuario       Usuario               @relation(fields: [usuarioId], references: [id])
  detalles      DetalleOrdenCompra[]

  @@index([proveedorId], map: "idx_ordencompra_proveedor")
  @@index([usuarioId], map: "idx_ordencompra_usuario")
  @@index([estado], map: "idx_ordencompra_estado")
}

model DetalleOrdenCompra {
  id             Int         @id @default(autoincrement())
  ordenCompraId  Int
  productoId     Int
  cantidad       Int
  precioUnitario Decimal     @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(12, 2)
  ordenCompra    OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  producto       Producto    @relation(fields: [productoId], references: [id])

  @@index([ordenCompraId], map: "idx_detalleordencompra_orden")
  @@index([productoId], map: "idx_detalleordencompra_producto")
}

model TurnoCaja {
  id             Int          @id @default(autoincrement())
  usuarioId      Int
  cajaId         Int          @default(1)
  fechaApertura  DateTime     @default(now())
  fechaCierre    DateTime?
  saldoInicial   Decimal      @db.Decimal(10, 2)
  saldoFinal     Decimal?     @db.Decimal(10, 2)
  totalIngresos  Decimal      @default(0) @db.Decimal(10, 2)
  totalEgresos   Decimal      @default(0) @db.Decimal(10, 2)
  diferencia     Decimal      @default(0) @db.Decimal(10, 2)
  observaciones  String?
  estado         EstadoTurno  @default(ABIERTO)
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])
  tickets        Ticket[]

  @@index([usuarioId], map: "idx_turnocaja_usuario")
  @@index([fechaApertura], map: "idx_turnocaja_fecha")
  @@index([estado], map: "idx_turnocaja_estado")
}

model ConfiguracionImpuesto {
  id                 Int        @id @default(autoincrement())
  nombre             String
  porcentaje         Decimal    @db.Decimal(5, 2)
  aplicadoPorDefecto Boolean    @default(false)
  activo             Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  productos          Producto[]
}

model Producto {
  id                 Int                   @id @default(autoincrement())
  codigoBarras       String                @unique
  nombre             String
  precioCosto        Decimal               @db.Decimal(10, 2)
  precioVenta        Decimal               @db.Decimal(10, 2)
  precioEspecial     Decimal?              @db.Decimal(10, 2)
  stock              Int                   @default(0)
  stockMinimo        Int                   @default(0)
  categoriaId        Int                   @default(1)
  proveedorId        Int?
  impuestoId         Int?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  updatedById        Int?
  categoria          Categoria             @relation(fields: [categoriaId], references: [id])
  proveedor          Proveedor?            @relation(fields: [proveedorId], references: [id])
  updatedBy          Usuario?              @relation(fields: [updatedById], references: [id])
  impuesto           ConfiguracionImpuesto? @relation(fields: [impuestoId], references: [id])
  StockMovement      StockMovement[]
  TicketItem         TicketItem[]
  DetalleOrdenCompra DetalleOrdenCompra[]

  @@index([nombre], map: "idx_producto_nombre")
  @@index([categoriaId], map: "idx_producto_categoria")
  @@index([proveedorId], map: "idx_producto_proveedor")
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  productos Producto[]

  @@index([nombre], map: "idx_categoria_nombre")
}

model Proveedor {
  id               Int           @id @default(autoincrement())
  nombre           String        @unique
  contacto         String?
  email            String?
  telefono         String?
  direccion        String?
  condicionesPago  String?
  descuentoPromedio Decimal      @default(0) @db.Decimal(5, 2)
  productos        Producto[]
  ordenesCompra    OrdenCompra[]

  @@index([nombre], map: "idx_proveedor_nombre")
}

model Usuario {
  id                 Int              @id @default(autoincrement())
  email              String?          @unique
  password           String
  rol                Rol
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  fullName           String
  cashMovements      CashMovement[]
  productos          Producto[]
  sessionEvents      SessionEvent[]
  StockMovement      StockMovement[]
  tickets            Ticket[]         @relation("UsuarioTickets")
  grantedPermissions UserPermission[] @relation("GrantedPermissions")
  userPermissions    UserPermission[]
  ordenesCompra      OrdenCompra[]
  turnosCaja         TurnoCaja[]

  @@index([email], map: "idx_usuario_email")
}

model Ticket {
  id             Int          @id @default(autoincrement())
  usuarioId      Int
  clienteId      Int?
  turnoCajaId    Int?
  numeroTicket   Int
  fecha          DateTime     @default(now())
  subtotal       Decimal      @default(0) @db.Decimal(12, 2)
  impuestos      Decimal      @default(0) @db.Decimal(12, 2)
  descuentoTotal Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  usuario        Usuario      @relation("UsuarioTickets", fields: [usuarioId], references: [id])
  turnoCaja      TurnoCaja?   @relation(fields: [turnoCajaId], references: [id])
  items          TicketItem[]

  @@unique([usuarioId, fecha, numeroTicket], name: "ticket_por_usuario_y_dia")
  @@index([usuarioId, fecha], map: "idx_ticket_usuario_fecha")
  @@index([turnoCajaId], map: "idx_ticket_turno")
}

model TicketItem {
  id             Int      @id @default(autoincrement())
  ticketId       Int
  productoId     Int
  cantidad       Int      @default(1)
  precioUnitario Decimal  @db.Decimal(10, 2)
  descuento      Decimal  @default(0) @db.Decimal(10, 2)
  impuesto       Decimal  @default(0) @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(12, 2)
  producto       Producto @relation(fields: [productoId], references: [id])
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId], map: "idx_ticketitem_ticket")
  @@index([productoId], map: "idx_ticketitem_producto")
}

model SessionEvent {
  id        Int        @id @default(autoincrement())
  usuarioId Int
  tipo      EventoTipo
  timestamp DateTime   @default(now())
  usuario   Usuario    @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, timestamp], map: "idx_sessionevent_usuario_timestamp")
}

model CashMovement {
  id          Int            @id @default(autoincrement())
  usuarioId   Int
  tipo        MovimientoTipo
  monto       Decimal        @db.Decimal(10, 2)
  descripcion String?
  createdAt   DateTime       @default(now())
  usuario     Usuario        @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, createdAt], map: "idx_cashmovement_usuario_createdat")
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  name            String
  description     String?
  module          String
  createdAt       DateTime         @default(now())
  userPermissions UserPermission[]

  @@index([module], map: "idx_permission_module")
  @@index([key], map: "idx_permission_key")
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  usuarioId    Int
  permissionId Int
  granted      Boolean    @default(true)
  grantedAt    DateTime   @default(now())
  grantedById  Int?
  grantedBy    Usuario?   @relation("GrantedPermissions", fields: [grantedById], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  usuario      Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, permissionId])
  @@index([usuarioId], map: "idx_userpermission_usuario")
  @@index([permissionId], map: "idx_userpermission_permission")
}

enum Rol {
  admin
  empleado
}

enum EventoTipo {
  LOGIN
  LOGOUT
}

enum MovimientoTipo {
  IN
  OUT
}

enum EstadoOrden {
  PENDIENTE
  RECIBIDA
  CANCELADA
}

enum EstadoTurno {
  ABIERTO
  CERRADO
}
